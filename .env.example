# ==========================================================
# Variables para docker compose (copiar a .env y completar)
# Este archivo SI se versiona. El .env real NO.
# ==========================================================

# PostgreSQL (contenedor)
POSTGRES_DB=taxicoop_db
POSTGRES_USER=taxicoop
POSTGRES_PASSWORD=cambia_esta_clave

# Autenticacion: cadena aleatoria larga (openssl rand -base64 48)
JWT_SECRET=cambia_esto_por_una_cadena_aleatoria_de_64_caracteres

# Puerto del frontend en el host (se publica en 127.0.0.1)
FRONTEND_PUBLISHED_PORT=8080

# Asistente IA (DeepSeek). La key real se pega solo en el .env, nunca se versiona.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Consulta de cedula/RUC (ZUINCONSUL)
ZUINCONSUL_URL=https://suilaft.tech/zuiconsul/api/v1/consulta.php
ZUINCONSUL_TOKEN=

# Documentos cifrados (AES-256-GCM)
FILE_ENCRYPTION_KEY=
UPLOADS_DIR=uploads
