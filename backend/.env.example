# Servidor
PORT=3000

# PostgreSQL
DB_NAME=taxicoop_db
DB_USER=postgres
DB_PASSWORD=cambia_esta_clave
DB_HOST=localhost
DB_PORT=5432

# MongoDB
MONGO_URI=mongodb://localhost:27017/taxicoop_mongo

# Autenticación (obligatorio): cadena aleatoria larga, no la compartas
JWT_SECRET=cambia_esto_por_una_cadena_aleatoria_de_64_caracteres

# Asistente IA (DeepSeek). La key vive SOLO en el backend, nunca en el frontend.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Consulta de cedula/RUC (ZUINCONSUL). El token vive SOLO en el backend.
ZUINCONSUL_URL=https://suilaft.tech/zuiconsul/api/v1/consulta.php
ZUINCONSUL_TOKEN=

# Documentos cifrados (AES-256-GCM). Cadena aleatoria larga.
FILE_ENCRYPTION_KEY=
UPLOADS_DIR=uploads
